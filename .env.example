# ==============================================================================
# Dr. Eman Ameen Pharmacy Management System - Environment Configuration
# Copy this template to .env on the target workstation before first startup.
# Redact or never commit actual production credentials to source repositories.
# ==============================================================================

# Database Settings (Internal to Docker network)
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=pharmacy_db

# Connection URL for FastAPI backend
DATABASE_URL=postgresql+psycopg2://pharmacy:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/pharmacy_db

# Security & Authentication Secrets
# Generate a cryptographically secure 64-hex key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_64_CHAR_HEX_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Configuration
APP_NAME=Dr. Eman Ameen Pharmacy
ENV=production
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Host Port Bindings
FRONTEND_PORT=80
API_PORT=8000
